# Copy to .env and fill in ONE of the two options.

# Option A: Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Option B: Vertex AI (uses your gcloud login)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model for the agent, the compaction summariser and memory extraction.
XRAY_MODEL=gemini-3.5-flash

# Start in offline mode even if a key is set (you can still switch in the UI).
# XRAY_OFFLINE=1

# ADK compacts after a turn whose prompt reaches this many tokens.
# Raise it if compaction fires too early in rehearsal; lower it if Act 4 does not compact.
XRAY_COMPACT_TOKENS=4000
XRAY_KEEP_EVENTS=6

# Max model calls per customer message (bounded loop).
XRAY_MAX_LLM_CALLS=8

# Optional: USD per million input tokens, if you want cost shown. Leave blank to hide.
XRAY_PRICE_PER_MTOK=
